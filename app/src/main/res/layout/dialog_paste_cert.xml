<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempel Sertifikat SSL (.crt &amp; .key)"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tempel teks sertifikat (.crt) dan private key (.key) di bawah ini. Data akan disimpan secara permanen di perangkat."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Domain Confirm -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nama Domain (e.g. absenku.duckdns.org)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Certificate CRT -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Sertifikat SSL (.crt) - Termasuk -----BEGIN CERTIFICATE-----">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogCrt"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Private Key KEY -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Private Key (.key) - Termasuk -----BEGIN PRIVATE KEY-----">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogKey"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
